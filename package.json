{
  "name": "penrose-svg-skill",
  "version": "0.1.0",
  "private": true,
  "description": "Codex skill for generating Penrose-rendered SVG diagrams.",
  "scripts": {
    "render:examples": "npm run render:examples:set-theory && npm run render:examples:directed-graph && npm run render:examples:geometry && npm run render:examples:vector-space",
    "render:examples:set-theory": "roger trios --trios examples/set-theory/disjoint-subsets.trio.json examples/set-theory/overlapping-fields.trio.json examples/set-theory/courseware-taxonomy.trio.json --out examples/set-theory/svg",
    "render:examples:directed-graph": "roger trio --trio examples/directed-graph/pipeline.trio.json --out examples/directed-graph/svg/pipeline.svg",
    "render:examples:geometry": "roger trio --trio examples/geometry/triangle.trio.json --out examples/geometry/svg/triangle.svg",
    "render:examples:vector-space": "roger trio --trio examples/vector-space/orthogonal-map.trio.json --out examples/vector-space/svg/orthogonal-map.svg"
  },
  "devDependencies": {
    "@penrose/roger": "^3.3.0"
  }
}
